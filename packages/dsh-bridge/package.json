{
  "name": "@zn-ai/dsh-bridge",
  "version": "0.0.0",
  "description": "zai → deepseek-harness bridge — long-running Cordis adapter for the dsh kernel track",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -b --force && cp src/dsh-bridge.patch.yml dist/dsh-bridge.patch.yml && node -e \"import('node:fs').then(({cpSync}) => cpSync('agent-presets','dist/agent-presets',{recursive:true}))\"",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "zai"
  ],
  "author": "ZN-AI",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
