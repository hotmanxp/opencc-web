{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/opencc-src/*"]
    },
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    // zai patch (2026-08-30, plan P3 fix build errors): emit despite TS6307
    // cascade from opencc-src vendor imports. Bundle (esbuild) produces
    // the real artifact; tsc -b's emit is best-effort for type surfaces.
    "noEmitOnError": false,
    // zai patch (2026-08-18): 只发类型,不发 .js。运行时唯一入口是
    // dist/opencc-core.mjs(bundle-opencc.ts esbuild 合成),tsc 编译出的
    // dist/compat/**/*.js / index.js / stateChangeBus.js 无人 import
    // (死重)。这里用 emitDeclarationOnly 只发射 bundle-entry.d.ts 类型
    // 链需要的 .d.ts,从源头消灭死 js(tsconfig.server.json 早已如此)。
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "jsx": "preserve",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "src/opencc-src",
    // zai patch (2026-08-09): esbuild-only 聚合入口,横跨 vendor(opencc-src)
    // 与 compat 两个 tsconfig 项目,由 scripts/bundle-opencc.ts 编译,不进
    // tsc 主项目(否则 TS6307:引用被 exclude 的 opencc-src)。
    "src/bundle-entry.ts"
  ]
}
