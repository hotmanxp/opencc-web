{
  "name": "@zn-ai/zn-agent-core",
  "version": "0.1.0",
  "description": "zai agent runtime core — 拷贝自 opencc 0.20.0，剥除 UI，zai 端消费",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./transcript": "./dist/transcript/store.js",
    "./commands": "./dist/commands/index.js",
    "./bashTracker": "./dist/tools/BashTool/bashTracker.js",
    "./taskListStore": "./dist/tools/Tasks/TaskListStore.js",
    "./agents/memoryLoader": "./dist/agents/memoryLoader.js",
    "./agents/memoryWatcher": "./dist/agents/memoryWatcher.js"
  },
  "files": [
    "dist/",
    "scripts/copy-runtime-assets.mjs"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-runtime-assets.mjs",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-from-opencc": "tsx scripts/copy-from-opencc.ts",
    "verify": "tsx scripts/verify-imports.ts"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@anthropic-ai/sdk": "^0.94.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-logs": "^0.55.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "ajv": "^8.17.1",
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "eventsource-parser": "^1.1.2",
    "execa": "^9.5.1",
    "figures": "^6.1.0",
    "ignore": "^5.3.2",
    "js-yaml": "^4.1.0",
    "latest-version": "^9.0.0",
    "lodash-es": "^4.17.21",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "semver": "^7.6.3",
    "yaml": "^2.6.0",
    "zod": "^3.23.8",
    "marked": "^14.1.3",
    "https-proxy-agent": "^7.0.6",
    "tree-kill": "^1.2.2",
    "jsonrepair": "^3.12.0",
    "shell-quote": "^1.8.1",
    "p-map": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.10.0",
    "@types/react": "^18.3.0",
    "typescript": "5.6.3",
    "vitest": "^2.1.0"
  }
}
