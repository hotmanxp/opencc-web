{
  "name": "@zn-ai/zn-agent-core",
  "version": "0.3.13",
  "description": "zai agent runtime core",
  "type": "module",
  "main": "dist/opencc-core.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/opencc-core.mjs"
    },
    "./runtime": "./dist/runtime/index.js",
    "./commands": "./dist/commands/index.js",
    "./bashTracker": "./dist/tools/BashTool/bashTracker.js",
    "./taskListStore": "./dist/tools/Tasks/TaskListStore.js",
    "./agents/memoryLoader": "./dist/agents/memoryLoader.js",
    "./agents/memoryWatcher": "./dist/agents/memoryWatcher.js",
    "./compat/vendor/ripgrep": "./dist/compat/vendor/ripgrep.js",
    "./compat/commands/handoffFs": "./dist/compat/commands/handoffFs.js",
    "./opencc-core": "./dist/opencc-core.mjs",
    "./opencc-src/permissions": "./dist/opencc-src/types/permissions.js",
    "./opencc-src/services/api/sessionApiCounter": "./dist/opencc-src/services/api/sessionApiCounter.js",
    "./opencc-src/server": "./dist/opencc-src/server/index.js",
    "./opencc-src/utils/model/genericModelCapabilities": "./dist/opencc-src/utils/model/genericModelCapabilities.js",
    "./opencc-server": {
      "types": "./dist/opencc-src/server/index.d.ts",
      "default": "./dist/opencc-src/server/index.js"
    },
    "./compat/permissions": "./dist/compat/permissions.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scripts/copy-runtime-assets.mjs",
    "vendor/"
  ],
  "bin": {
    "rg-darwin-arm64": "vendor/ripgrep/rg-darwin-arm64",
    "rg-darwin-x64": "vendor/ripgrep/rg-darwin-x64",
    "rg-win32-x64": "vendor/ripgrep/rg-win32-x64.exe"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/bundle-opencc.ts && tsc -b && node scripts/tsc-with-cache.mjs tsconfig.contract-tests.json && node scripts/tsc-with-cache.mjs tsconfig.consumer.json && node scripts/copy-runtime-assets.mjs && node scripts/verify-server-types-self-contained.mjs && find dist -name '*.map' -delete",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.contract-tests.json && tsc --noEmit -p tsconfig.consumer.json && node scripts/verify-server-types-self-contained.mjs",
    "typecheck:contract-tests": "tsc --noEmit -p tsconfig.contract-tests.json",
    "typecheck:consumer": "tsc --noEmit -p tsconfig.consumer.json && node scripts/verify-server-types-self-contained.mjs",
    "typecheck:server-types-self-contained": "node scripts/verify-server-types-self-contained.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-server-types-self-contained.mjs",
    "bundle": "node --experimental-strip-types scripts/bundle-opencc.ts"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sandbox-runtime": "^0.0.67",
    "@anthropic-ai/sdk": "^0.94.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "acorn": "^8.18.0",
    "ajv": "^8.18.0",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.18.1",
    "bidi-js": "^1.0.3",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "cli-boxes": "^4.0.1",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "emoji-regex": "^10.6.0",
    "env-paths": "^4.0.0",
    "eventsource-parser": "^1.1.2",
    "execa": "^9.5.1",
    "fflate": "0.8.3",
    "figures": "^6.1.0",
    "fuse.js": "^7.5.0",
    "get-east-asian-width": "^1.6.0",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "ignore": "^5.3.2",
    "indent-string": "^5.0.0",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.15.0",
    "latest-version": "^9.0.0",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.2",
    "marked": "^14.1.3",
    "p-map": "^7.0.6",
    "picomatch": "^4.0.5",
    "preact": "^10.29.8",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react-compiler-runtime": "^1.0.0",
    "semver": "^7.8.5",
    "sharp": "^0.33.5",
    "shell-quote": "^1.10.0",
    "signal-exit": "^4.1.0",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.5.0",
    "tree-kill": "^1.2.2",
    "type-fest": "^5.8.0",
    "undici": "^8.9.0",
    "usehooks-ts": "^3.1.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.1",
    "xss": "^1.0.15",
    "yaml": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.10.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.1",
    "react": "^19.2.8",
    "typescript": "5.6.3",
    "vitest": "^2.1.0",
    "react-reconciler": "^0.33.0"
  }
}
