{
  "name": "zn-agent-assets",
  "version": "1.0.0",
  "description": "AI Agent \u914d\u7f6e\u8d44\u6e90\u5e93 - Nova CLI \u7684 agent \u914d\u7f6e\u3001\u547d\u4ee4\u5b9a\u4e49\u3001\u6280\u80fd\u6a21\u5757\u53ca\u53d1\u5e03\u5de5\u5177",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @zn-ai/zai-agent-core run build && pnpm --filter @zn-ai/zai run build",
    "clean": "pnpm -r run clean",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test"
  },
  "keywords": [
    "nova",
    "opencode",
    "agent",
    "assets"
  ],
  "author": "ZN-AI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown"
    ]
  }
}